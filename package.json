{
  "name": "home-architect",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive, CAD-like Floor Plan Creator and Automation Dashboard for Home Assistant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SocrateMobile/home-architect.git"
  },
  "bugs": {
    "url": "https://github.com/SocrateMobile/home-architect/issues"
  },
  "homepage": "https://github.com/SocrateMobile/home-architect#readme",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node scripts/sync-version.js",
    "version:sync": "node scripts/sync-version.js",
    "version:check": "node scripts/sync-version.js --check",
    "build": "npm run version:sync && npm run typecheck && vite build",
    "check:bundle": "node .github/scripts/check-bundle.mjs"
  },
  "keywords": [
    "home-assistant",
    "floorplan",
    "cad",
    "hacs",
    "lit",
    "svg"
  ],
  "author": "Jean-Frederic Lavigne",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "lit": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
